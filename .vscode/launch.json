{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Launch BlazorWebTemplate.Web",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-web",
      "program": "${workspaceFolder}/BlazorWebTemplate.Web/bin/Debug/net8.0/BlazorWebTemplate.Web.dll",
      "cwd": "${workspaceFolder}/BlazorWebTemplate.Web",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "stopAtEntry": false,
      "console": "integratedTerminal"
    }
  ]
}
