{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Brand identity — product name, tagline, and color palette applied via AppBrandOptions
  "Branding": {
    "ProductName": "Unictive Control Center",
    "ProductTagline": "Enterprise content operations",
    "ProductDescription": "A reusable admin shell for content, workflow, and team operations.",
    "CompanyName": "Unictive",
    "SupportEmail": "support@unictive.example",
    "PrimaryColor": "#1F4FD8",
    "SecondaryColor": "#0F172A",
    "AccentColor": "#14B8A6"
  },
  // Unictive Backend API — base URL and HTTP client tuning
  "UnictiveApi": {
    "BaseUrl": "https://localhost:7001/",
    // Timeout for individual HTTP requests (seconds)
    "RequestTimeoutSeconds": 20,
    // Number of retry attempts on transient failures
    "RetryCount": 2,
    // Delay between retries (milliseconds)
    "RetryDelayMilliseconds": 250,
    // Default page size for paginated API requests (1–100)
    "DefaultPageSize": 20
  },
  // Authentication cookie settings
  "AppAuth": {
    // Name of the browser cookie used to store the auth session
    "CookieName": "BlazorWebTemplate.Auth",
    // Sliding expiration window for the auth cookie (hours, 1–72)
    "ExpireTimeSpanHours": 8
  },
  // Dashboard page settings
  "AppDashboard": {
    // How long (minutes) the cached dashboard summary is considered fresh (1–60)
    "FreshnessMinutes": 2
  }
}
