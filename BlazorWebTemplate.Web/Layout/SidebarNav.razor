<MudStack Class="editorial-sidebar" Spacing="3">
    <MudStack Spacing="1" Class="editorial-brand">
        <MudText Typo="Typo.overline" Class="editorial-kicker">Blazor Web App</MudText>
        <MudText Typo="Typo.h4">Unictive CMS</MudText>
        <MudText Typo="Typo.body2">Frontend-first operations workspace with clean boundaries, secure auth flow, and REST-driven modules.</MudText>
    </MudStack>

    <AuthorizeView>
        <Authorized Context="shellAuth">
            <MudNavMenu Rounded="true" Dense="true" Class="editorial-nav">
                <MudNavLink Href="/dashboard" Match="NavLinkMatch.All" Icon="@Icons.Material.Rounded.SpaceDashboard">Dashboard</MudNavLink>
                <MudNavLink Href="/posts" Icon="@Icons.Material.Rounded.Article">Posts</MudNavLink>
                <MudNavLink Href="/categories" Icon="@Icons.Material.Rounded.GridView">Categories</MudNavLink>
                <AuthorizeView Roles="@RoleNames.Admin">
                    <Authorized Context="adminAuth">
                        <MudNavLink Href="/users" Icon="@Icons.Material.Rounded.People">Users</MudNavLink>
                    </Authorized>
                </AuthorizeView>
            </MudNavMenu>
        </Authorized>
        <NotAuthorized>
            <MudNavMenu Rounded="true" Dense="true" Class="editorial-nav">
                <MudNavLink Href="/login" Icon="@Icons.Material.Rounded.Login">Login</MudNavLink>
            </MudNavMenu>
        </NotAuthorized>
    </AuthorizeView>

    <MudPaper Elevation="0" Class="editorial-note">
        <MudText Typo="Typo.overline" Class="editorial-kicker">Architecture</MudText>
        <MudText Typo="Typo.body2">Web owns UI. Backend owns auth, API access, retries, and mapping. Shared keeps contracts stable for onboarding.</MudText>
    </MudPaper>
</MudStack>
