@inject Microsoft.Extensions.Options.IOptions<AppBrandOptions> BrandOptionsAccessor

<MudThemeProvider Theme="@_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<NotificationHost />

<Routes />

@code {
    private MudTheme _theme = new();

    protected override void OnInitialized()
    {
        _theme = AppThemeFactory.Create(BrandOptionsAccessor.Value);
    }
}
