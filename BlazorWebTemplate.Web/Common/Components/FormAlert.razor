@if (!string.IsNullOrWhiteSpace(Message))
{
    <div class="status-banner @GetCssClass()" role="status">
        <strong>@Title</strong>
        <span>@Message</span>
    </div>
}

@code {
    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string? Message { get; set; }

    [Parameter]
    public bool IsError { get; set; }

    private string GetCssClass() => IsError ? "status-banner-error" : "status-banner-success";
}
