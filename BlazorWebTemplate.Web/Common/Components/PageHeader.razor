@inject AppShellState ShellState

<section class="app-page-header">
    <div class="app-page-header__copy">
        @if (Breadcrumbs?.Count > 0)
        {
            <nav class="app-breadcrumbs" aria-label="Breadcrumb">
                @foreach (var breadcrumb in Breadcrumbs)
                {
                    if (string.IsNullOrWhiteSpace(breadcrumb.Href))
                    {
                        <span class="app-breadcrumbs__current">@breadcrumb.Label</span>
                    }
                    else
                    {
                        <MudLink Href="@breadcrumb.Href" Class="app-breadcrumbs__link">@breadcrumb.Label</MudLink>
                    }
                }
            </nav>
        }

        @if (!string.IsNullOrWhiteSpace(Section))
        {
            <MudText Typo="Typo.overline" Class="app-page-header__section">@Section</MudText>
        }

        <MudText Typo="Typo.h3">@Title</MudText>

        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <MudText Typo="Typo.body2" Class="app-text-muted">@Subtitle</MudText>
        }
    </div>

    @if (Actions is not null)
    {
        <div class="app-page-header__actions">
            @Actions
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Section { get; set; }

    [Parameter]
    public string? Subtitle { get; set; }

    [Parameter]
    public IReadOnlyList<AppShellBreadcrumb>? Breadcrumbs { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }

    protected override void OnParametersSet()
    {
        ShellState.SetPage(Title, Section, Breadcrumbs);
    }
}
