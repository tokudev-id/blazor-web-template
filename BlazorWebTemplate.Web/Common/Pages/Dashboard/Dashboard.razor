@page "/"
@page "/dashboard"
@attribute [Authorize]

<PageTitle>Dashboard</PageTitle>

@if (_isLoading)
{
    <Loading Height="148px" />
}
else if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <StateView ErrorMessage="@_errorMessage" />
}
else if (_summary is not null)
{
    <MudStack Spacing="3">
        <PageHeader Title="Operations overview"
                    Section="Workspace"
                    Subtitle="A clean enterprise shell for user access and workflow signals."
                    Breadcrumbs="@_breadcrumbs" />

        <MudGrid Spacing="3">
            <MudItem xs="12" sm="6" lg="6">
                <StatCard Icon="@Icons.Material.Rounded.People"
                          Label="Users"
                          Value="@_summary.TotalUsers.ToString()"
                          Description="People available in the current directory."
                          Featured="true" />
            </MudItem>
            <MudItem xs="12" sm="6" lg="6">
                <StatCard Icon="@Icons.Material.Rounded.Schedule"
                          Label="Last refresh"
                          Value="@_summary.LastUpdatedUtc.ToLocalTime().ToString("HH:mm")"
                          Description="@_summary.LastUpdatedUtc.ToLocalTime().ToString("dddd, dd MMM yyyy")" />
            </MudItem>
        </MudGrid>

        <MudGrid Spacing="3">
            <MudItem xs="12">
                <PageSection Section="Platform"
                             Title="What this template ships"
                             Subtitle="The defaults are designed to be branded, extended, and audited cleanly.">
                    <ChildContent>
                        <MudStack Spacing="1" Class="app-bullet-list">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Rounded.Lock" Color="Color.Primary" Size="Size.Small" />
                                <MudText Typo="Typo.body2">Cookie auth with route protection and role-aware navigation.</MudText>
                            </MudStack>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Rounded.Api" Color="Color.Primary" Size="Size.Small" />
                                <MudText Typo="Typo.body2">Backend adapters with retry and correlation support.</MudText>
                            </MudStack>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Rounded.Widgets" Color="Color.Primary" Size="Size.Small" />
                                <MudText Typo="Typo.body2">Reusable page, card, table, and confirmation primitives.</MudText>
                            </MudStack>
                        </MudStack>
                    </ChildContent>
                </PageSection>
            </MudItem>
        </MudGrid>
    </MudStack>
}
