@page "/roles"
@attribute [Authorize(Policy = AppPolicyFor.AdminOnly)]

<PageTitle>Roles</PageTitle>

<MudStack Spacing="3">
    <PageHeader Title="Roles"
                Section="Administration"
                Subtitle="Manage roles and their associated permissions across the workspace."
                Breadcrumbs="@_breadcrumbs" />

    <DataGridShell TItem="RoleSummary"
                   Section="Directory"
                   Title="Role directory"
                   Subtitle="All roles currently defined in the system."
                   Items="@_roles"
                   ErrorMessage="@_rolesError"
                   IsLoading="@_rolesLoading"
                   EmptyTitle="No roles found"
                   EmptyMessage="No roles have been defined in the system yet.">
        <HeaderActions>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Rounded.Add"
                       Size="Size.Small"
                       OnClick="OpenCreateRoleDialogAsync">
                New role
            </MudButton>
        </HeaderActions>
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Permissions</MudTh>
            <MudTh>Assigned Users</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">
                <MudText Typo="Typo.body2" Style="font-weight:600">@context.Name</MudText>
            </MudTd>
            <MudTd DataLabel="Permissions">
                @if (context.Permissions.Count == 0)
                {
                    <MudText Typo="Typo.caption" Class="app-text-muted">—</MudText>
                }
                else
                {
                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                        @foreach (var perm in context.Permissions.Take(_maxPermsVisible))
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                     Color="Color.Default" Class="app-perm-chip">@perm</MudChip>
                        }
                        @if (context.Permissions.Count > _maxPermsVisible)
                        {
                            <MudTooltip Text="@string.Join(", ", context.Permissions.Skip(_maxPermsVisible))">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                         Color="Color.Default" Class="app-perm-chip">
                                    +@(context.Permissions.Count - _maxPermsVisible) more
                                </MudChip>
                            </MudTooltip>
                        }
                    </MudStack>
                }
            </MudTd>
            <MudTd DataLabel="Assigned Users">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudIcon Icon="@Icons.Material.Rounded.People" Size="Size.Small" Class="app-text-muted" />
                    <MudText Typo="Typo.body2">@context.UsersCount</MudText>
                </MudStack>
            </MudTd>
            <MudTd>
                <MudMenu Icon="@Icons.Material.Rounded.MoreVert" Size="Size.Small" Dense="true"
                         AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <MudMenuItem Icon="@Icons.Material.Rounded.EditNote"
                                 Href="@($"/roles/{context.Id}")">
                        Manage
                    </MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Rounded.DeleteOutline"
                                 IconColor="Color.Error"
                                 Disabled="@_deletingRoleId.Contains(context.Id)"
                                 OnClick="@(() => DeleteRoleAsync(context))">
                        Delete
                    </MudMenuItem>
                </MudMenu>
            </MudTd>
        </RowTemplate>
        <FooterContent>
            <div class="app-pagination">
                <span></span>
                @if (_roles.Count > 0)
                {
                    <MudText Typo="Typo.caption" Class="app-text-muted">@_roles.Count total roles</MudText>
                }
            </div>
        </FooterContent>
    </DataGridShell>
</MudStack>
