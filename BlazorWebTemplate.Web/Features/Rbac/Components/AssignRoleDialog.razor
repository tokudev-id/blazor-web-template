@using BlazorWebTemplate.Client.Services.BackEnd.Rbac
@inject IRbacService RbacService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Rounded.ManageAccounts" Class="mr-2" />
            Assign role — @DisplayName
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">

            @if (_rolesLoading)
            {
                <Loading Height="48px" />
            }
            else if (_currentRoles.Count > 0)
            {
                <div>
                    <MudText Typo="Typo.caption" Class="app-text-muted">Current roles</MudText>
                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-1">
                        @foreach (var role in _currentRoles)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled">@role</MudChip>
                        }
                    </MudStack>
                </div>
            }
            else if (!_rolesLoading)
            {
                <MudText Typo="Typo.body2" Class="app-text-muted">This user has no roles assigned yet.</MudText>
            }

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true">@_errorMessage</MudAlert>
            }

            <MudSelect T="string"
                       @bind-Value="_selectedRole"
                       Label="Role to assign"
                       Variant="Variant.Outlined"
                       Disabled="@_assigning">
                <MudSelectItem Value="@("Admin")">Admin</MudSelectItem>
                <MudSelectItem Value="@("Editor")">Editor</MudSelectItem>
                <MudSelectItem Value="@("Viewer")">Viewer</MudSelectItem>
            </MudSelect>

        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Cancel</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="AssignAsync"
                   Disabled="@(_assigning || string.IsNullOrWhiteSpace(_selectedRole))">
            @if (_assigning)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Assign role
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string UserId { get; set; } = string.Empty;

    [Parameter]
    public string DisplayName { get; set; } = string.Empty;

    private List<string> _currentRoles = [];
    private bool _rolesLoading = true;
    private string _selectedRole = string.Empty;
    private bool _assigning;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var result = await RbacService.GetUserRolesAsync(UserId);
        _rolesLoading = false;
        if (result.IsSuccess && result.Value is not null)
            _currentRoles = result.Value;
    }

    private async Task AssignAsync()
    {
        _errorMessage = null;
        _assigning = true;

        var result = await RbacService.AssignRoleAsync(UserId, _selectedRole);
        _assigning = false;

        if (result.IsFailure)
        {
            _errorMessage = result.Error?.Message ?? "Failed to assign role.";
            return;
        }

        MudDialog.Close(DialogResult.Ok(_selectedRole));
    }

    private void Cancel() => MudDialog.Cancel();
}
