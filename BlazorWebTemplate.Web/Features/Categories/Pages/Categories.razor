@page "/categories"
@attribute [Authorize]

<PageTitle>Categories</PageTitle>

<MudStack Spacing="3">
    <PageHeader Title="Categories"
                Section="Taxonomy"
                Subtitle="Search categories and pivot straight into the related content feed."
                Breadcrumbs="@_breadcrumbs" />

    <PageSection Section="Filters"
                 Title="Category lookup"
                 Subtitle="Keep naming systems consistent across modules and editorial flows.">
        <PageToolbar>
            <MudTextField T="string" Label="Search categories" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_searchInput" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ApplySearch">Filter</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="ClearSearch">Clear</MudButton>
        </PageToolbar>
    </PageSection>

    <StateView IsLoading="@_isLoading"
               ErrorMessage="@_errorMessage"
               IsEmpty="@(!_isLoading && string.IsNullOrWhiteSpace(_errorMessage) && _categories.Count == 0)"
               EmptyTitle="No categories matched"
               EmptyMessage="Try a different term or clear the filter to browse the full taxonomy list.">
        <ChildContent>
            <MudGrid Spacing="3">
                @foreach (var category in _categories)
                {
                    <MudItem xs="12" md="6" lg="4">
                        <PageSection Section="Category"
                                     Title="@category.Name"
                                     Subtitle="@category.Description"
                                     Class="app-category-card">
                            <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small">@category.Slug</MudChip>
                            <MudButton Href="@category.Url" Variant="Variant.Text" Color="Color.Primary" EndIcon="@Icons.Material.Rounded.ArrowForward">Use this filter</MudButton>
                        </PageSection>
                    </MudItem>
                }
            </MudGrid>
        </ChildContent>
    </StateView>
</MudStack>
