@page "/categories"
@attribute [Authorize]
@inject ICategoryService CategoryService
@inject NavigationManager NavigationManager

<PageTitle>Categories</PageTitle>

@if (_isLoading)
{
    <MudSkeleton Height="320px" Class="editorial-skeleton" />
}
else if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true">@_errorMessage</MudAlert>
}
else if (_categories.Count == 0)
{
    <MudPaper Elevation="0" Class="editorial-panel">
        <MudText Typo="Typo.h4">No categories matched.</MudText>
        <MudText Typo="Typo.body2" Class="editorial-muted">Try a different term or clear the filter to browse the full starter taxonomy list.</MudText>
    </MudPaper>
}
else
{
    <MudStack Spacing="3">
        <MudPaper Elevation="0" Class="editorial-panel">
            <MudText Typo="Typo.overline" Class="editorial-kicker">Taxonomy</MudText>
            <MudText Typo="Typo.h3">Keep content grouped with a clear naming system</MudText>
            <MudText Typo="Typo.body2" Class="editorial-muted">Search categories and route directly into the filtered content feed.</MudText>
            <MudStack Row="true" Spacing="2" Class="editorial-toolbar">
                <MudTextField T="string" Label="Search categories" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_searchInput" />
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="ApplySearch">Filter</MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="ClearSearch">Clear</MudButton>
            </MudStack>
        </MudPaper>

        <MudGrid Spacing="3">
            @foreach (var category in _categories)
            {
                <MudItem xs="12" md="6" lg="4">
                    <MudPaper Elevation="0" Class="editorial-panel editorial-category-card">
                        <MudText Typo="Typo.overline" Class="editorial-kicker">Category</MudText>
                        <MudText Typo="Typo.h4">@category.Name</MudText>
                        <MudText Typo="Typo.body2" Class="editorial-muted">@category.Description</MudText>
                        <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small">@category.Slug</MudChip>
                        <MudButton Href="@category.Url" Variant="Variant.Text" Color="Color.Primary" EndIcon="@Icons.Material.Rounded.ArrowForward">Use this filter</MudButton>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    </MudStack>
}

@code {
    [SupplyParameterFromQuery(Name = "search")]
    public string? Search { get; set; }

    private List<CategorySummary> _categories = [];
    private bool _isLoading = true;
    private string? _errorMessage;
    private string _searchInput = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _searchInput = Search ?? string.Empty;
        var result = await CategoryService.GetCategoriesAsync(Search);
        _isLoading = false;

        if (result.IsFailure)
        {
            _errorMessage = result.Error?.Message ?? "The categories could not be loaded.";
            _categories = [];
            return;
        }

        _errorMessage = null;
        _categories = result.Value?.ToList() ?? [];
    }

    private void ApplySearch()
        => NavigationManager.NavigateTo(string.IsNullOrWhiteSpace(_searchInput)
            ? "/categories"
            : $"/categories?search={Uri.EscapeDataString(_searchInput)}", forceLoad: true);

    private void ClearSearch()
        => NavigationManager.NavigateTo("/categories", forceLoad: true);
}
