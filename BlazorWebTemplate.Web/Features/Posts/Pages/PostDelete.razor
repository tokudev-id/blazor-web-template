@page "/posts/{Id:int}/delete"
@attribute [Authorize(Policy = AppPolicies.EditorOrAbove)]

<PageTitle>Delete post</PageTitle>

@if (_isLoading)
{
    <Loading Height="240px" />
}
else if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <StateView ErrorMessage="@_errorMessage" />
}
else if (_post is not null)
{
    <MudStack Spacing="3">
        <PageHeader Title="Delete post"
                    Section="Destructive action"
                    Subtitle="This flow adds an explicit confirmation step so destructive actions are safer by default."
                    Breadcrumbs="@_breadcrumbs" />

        <ConfirmPanel Section="Delete"
                      Title="Remove this post?"
                      Message="Type the post title to unlock the destructive action."
                      WarningMessage="DummyJSON simulates delete operations, which keeps this confirmation pattern safe to demonstrate in the starter template."
                      Class="app-confirm-panel--danger">
            <HighlightContent>
                <MudText Typo="Typo.subtitle1">@_post.Title</MudText>
                <MudText Typo="Typo.body2" Class="app-text-muted">@_post.Body</MudText>
            </HighlightContent>
            <ChildContent>
                <EditForm Model="_deleteFormModel" FormName="delete-post-form" method="post" OnSubmit="HandleDeleteAsync">
                    <MudStack Spacing="2">
                        <MudTextField T="string"
                                      Label="Confirm title"
                                      Variant="Variant.Outlined"
                                      HelperText="Enter the exact post title to unlock delete."
                                      @bind-Value="_confirmationInput" />
                        <MudStack Row="true" Spacing="2">
                            <MudButton Href="@AppRoutes.PostDetails(Id)" Variant="Variant.Outlined" Color="Color.Secondary">Cancel</MudButton>
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Error" Disabled="@(_isSubmitting || !CanDelete)">
                                @(_isSubmitting ? "Deleting..." : "Confirm delete")
                            </MudButton>
                        </MudStack>
                    </MudStack>
                </EditForm>
            </ChildContent>
        </ConfirmPanel>
    </MudStack>
}
