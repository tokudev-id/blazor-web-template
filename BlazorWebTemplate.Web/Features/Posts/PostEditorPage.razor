@page "/posts/new"
@page "/posts/{Id:int}/edit"
@attribute [Authorize(Policy = AppPolicies.EditorOrAbove)]
@inject IPostService PostService
@inject NavigationManager NavigationManager

<PageTitle>@(IsEditMode ? "Edit post" : "Create post")</PageTitle>

@if (!string.IsNullOrWhiteSpace(_loadErrorMessage))
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true">@_loadErrorMessage</MudAlert>
}
else
{
    <MudPaper Elevation="0" Class="editorial-panel editorial-form-panel">
        <MudText Typo="Typo.overline" Class="editorial-kicker">@((IsEditMode ? "Update" : "Create"))</MudText>
        <MudText Typo="Typo.h3">@(IsEditMode ? "Refine the post draft" : "Start a new post draft")</MudText>
        <MudText Typo="Typo.body2" Class="editorial-muted">Validated forms stay in the Web project while the Backend project keeps write orchestration and mapping isolated.</MudText>

        @if (!string.IsNullOrWhiteSpace(_saveErrorMessage))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true">@_saveErrorMessage</MudAlert>
        }

        <EditForm Model="Model" FormName="post-editor-form" method="post" OnValidSubmit="HandleSubmitAsync">
            <DataAnnotationsValidator />
            <MudStack Spacing="2">
                <MudTextField T="string" Label="Title" Variant="Variant.Outlined" @bind-Value="Model.Title" For="@(() => Model.Title)" />
                <MudTextField T="string" Label="Tags" Variant="Variant.Outlined" HelperText="Use comma-separated tags, for example cms, editorial, workflow." @bind-Value="Model.Tags" For="@(() => Model.Tags)" />
                <MudTextField T="string" Label="Body" Variant="Variant.Outlined" Lines="12" @bind-Value="Model.Body" For="@(() => Model.Body)" />
                <MudStack Row="true" Spacing="2">
                    <MudButton Href="/posts" Variant="Variant.Outlined" Color="Color.Secondary">Cancel</MudButton>
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@_isSubmitting">
                        @(_isSubmitting ? "Saving..." : IsEditMode ? "Save changes" : "Create post")
                    </MudButton>
                </MudStack>
            </MudStack>
        </EditForm>
    </MudPaper>
}

@code {
    [Parameter]
    public int? Id { get; set; }

    [SupplyParameterFromForm]
    private PostUpsertRequest Model { get; set; } = new();

    private bool IsEditMode => Id.HasValue;
    private string? _saveErrorMessage;
    private string? _loadErrorMessage;
    private bool _isSubmitting;
    private int? _loadedForPostId;

    protected override async Task OnParametersSetAsync()
    {
        _loadErrorMessage = null;

        if (!IsEditMode)
        {
            _loadedForPostId = null;
            return;
        }

        if (_loadedForPostId == Id)
        {
            return;
        }

        var result = await PostService.GetPostAsync(Id!.Value);
        if (result.IsFailure || result.Value is null)
        {
            _loadErrorMessage = result.Error?.Message ?? "The existing post could not be loaded.";
            _loadedForPostId = Id;
            return;
        }

        Model = new PostUpsertRequest
        {
            Title = result.Value.Title,
            Body = result.Value.Body,
            Tags = string.Join(", ", result.Value.Tags),
        };

        _loadedForPostId = Id;
    }

    private async Task HandleSubmitAsync()
    {
        if (_isSubmitting)
        {
            return;
        }

        _isSubmitting = true;
        _saveErrorMessage = null;

        ApiResult<PostDetail> result = IsEditMode
            ? await PostService.UpdateAsync(Id!.Value, Model)
            : await PostService.CreateAsync(Model);

        _isSubmitting = false;

        if (result.IsFailure || result.Value is null)
        {
            _saveErrorMessage = result.Error?.Message ?? "The post could not be saved.";
            return;
        }

        NavigationManager.NavigateTo($"/posts/{result.Value.Id}", forceLoad: true);
    }
}
