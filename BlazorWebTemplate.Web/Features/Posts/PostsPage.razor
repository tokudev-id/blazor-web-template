@page "/posts"
@attribute [Authorize]
@inject IPostService PostService
@inject NavigationManager NavigationManager

<PageTitle>Posts</PageTitle>

@if (_isLoading)
{
    <MudSkeleton Height="360px" Class="editorial-skeleton" />
}
else if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true">@_errorMessage</MudAlert>
}
else if (_posts is not null && _posts.Items.Count == 0)
{
    <MudPaper Elevation="0" Class="editorial-panel">
        <MudText Typo="Typo.h4">No posts matched this filter.</MudText>
        <MudText Typo="Typo.body2" Class="editorial-muted">Adjust the search or clear the tag filter to see the starter content again.</MudText>
    </MudPaper>
}
else if (_posts is not null)
{
    <MudStack Spacing="3">
        <MudPaper Elevation="0" Class="editorial-panel">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="editorial-panel-head">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.overline" Class="editorial-kicker">Posts</MudText>
                    <MudText Typo="Typo.h3">Manage the content collection</MudText>
                    <MudText Typo="Typo.body2" Class="editorial-muted">Search, scan, and route into details or editing without leaving the core workspace.</MudText>
                </MudStack>
                <AuthorizeView Policy="@AppPolicies.EditorOrAbove">
                    <Authorized>
                        <MudButton Href="/posts/new" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add">Create post</MudButton>
                    </Authorized>
                </AuthorizeView>
            </MudStack>

            <MudStack Row="true" Spacing="2" Class="editorial-toolbar">
                <MudTextField T="string" Label="Search posts" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_queryInput" />
                <MudTextField T="string" Label="Filter by tag" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_tagInput" />
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="ApplyFilters">Apply</MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="ClearFilters">Clear</MudButton>
            </MudStack>
        </MudPaper>

        <MudPaper Elevation="0" Class="editorial-panel">
            <MudTable T="PostSummary" Items="_posts.Items" Hover="true" Dense="true" Elevation="0" Class="editorial-table">
                <HeaderContent>
                    <MudTh>Title</MudTh>
                    <MudTh>Author</MudTh>
                    <MudTh>Views</MudTh>
                    <MudTh>Tags</MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Title">
                        <MudLink Href="@($"/posts/{context.Id}")" Typo="Typo.subtitle2">@context.Title</MudLink>
                        <MudText Typo="Typo.body2" Class="editorial-muted">@context.Excerpt</MudText>
                    </MudTd>
                    <MudTd DataLabel="Author">@context.AuthorName</MudTd>
                    <MudTd DataLabel="Views">@context.Views</MudTd>
                    <MudTd DataLabel="Tags">
                        <MudStack Row="true" Spacing="1">
                            @foreach (var tag in context.Tags.Take(3))
                            {
                                <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small" Href="@BuildTagLink(tag)">@tag</MudChip>
                            }
                        </MudStack>
                    </MudTd>
                    <MudTd DataLabel="Actions">
                        <MudStack Row="true" Spacing="1">
                            <MudButton Href="@($"/posts/{context.Id}")" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small">Details</MudButton>
                            <AuthorizeView Policy="@AppPolicies.EditorOrAbove">
                                <Authorized Context="editorAuth">
                                    <MudButton Href="@($"/posts/{context.Id}/edit")" Variant="Variant.Text" Color="Color.Secondary" Size="Size.Small">Edit</MudButton>
                                </Authorized>
                            </AuthorizeView>
                        </MudStack>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>

        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="editorial-pager">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="@BuildPageLink(_posts.PageNumber - 1)" Disabled="@(!_posts.HasPreviousPage)">Previous</MudButton>
            <MudText Typo="Typo.body2" Class="editorial-muted">Page @_posts.PageNumber of @Math.Max(_posts.TotalPages, 1)</MudText>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="@BuildPageLink(_posts.PageNumber + 1)" Disabled="@(!_posts.HasNextPage)">Next</MudButton>
        </MudStack>
    </MudStack>
}

@code {
    [SupplyParameterFromQuery(Name = "page")]
    public int? Page { get; set; }

    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    [SupplyParameterFromQuery(Name = "tag")]
    public string? Tag { get; set; }

    private PagedResult<PostSummary>? _posts;
    private bool _isLoading = true;
    private string? _errorMessage;
    private string _queryInput = string.Empty;
    private string _tagInput = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        _queryInput = Query ?? string.Empty;
        _tagInput = Tag ?? string.Empty;

        var result = await PostService.GetPostsAsync(new PostQuery(
            PageNumber: Math.Max(Page ?? 1, 1),
            PageSize: 9,
            Search: Query,
            Tag: Tag));

        _isLoading = false;

        if (result.IsFailure)
        {
            _errorMessage = result.Error?.Message ?? "The post listing could not be loaded.";
            _posts = null;
            return;
        }

        _posts = result.Value;
    }

    private void ApplyFilters()
        => NavigationManager.NavigateTo(BuildFilterLink(1, _queryInput, _tagInput), forceLoad: true);

    private void ClearFilters()
        => NavigationManager.NavigateTo("/posts", forceLoad: true);

    private string BuildPageLink(int pageNumber)
        => BuildFilterLink(pageNumber, Query, Tag);

    private static string BuildTagLink(string tag)
        => $"/posts?tag={Uri.EscapeDataString(tag)}";

    private static string BuildFilterLink(int pageNumber, string? query, string? tag)
    {
        var querySegments = new List<string> { $"page={pageNumber}" };

        if (!string.IsNullOrWhiteSpace(query))
        {
            querySegments.Add($"q={Uri.EscapeDataString(query)}");
        }

        if (!string.IsNullOrWhiteSpace(tag))
        {
            querySegments.Add($"tag={Uri.EscapeDataString(tag)}");
        }

        return $"/posts?{string.Join("&", querySegments)}";
    }
}
