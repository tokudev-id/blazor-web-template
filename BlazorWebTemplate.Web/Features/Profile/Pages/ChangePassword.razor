@page "/change-password"
@attribute [Authorize]

<PageTitle>Change Password</PageTitle>

<MudStack Spacing="3">
    <PageHeader Title="Change password"
                Section="Security"
                Subtitle="Choose a strong password you haven't used before."
                Breadcrumbs="@_breadcrumbs" />

    <MudGrid Spacing="3">
        <MudItem xs="12" md="6">
            <PageSection Section="Security"
                         Title="Change password"
                         Subtitle="Choose a strong password you haven't used before.">
                <ChildContent>
                    <MudStack Spacing="3">
                        @if (!string.IsNullOrWhiteSpace(_passwordError))
                        {
                            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true">@_passwordError</MudAlert>
                        }
                        @if (!string.IsNullOrWhiteSpace(_passwordSuccess))
                        {
                            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true">@_passwordSuccess</MudAlert>
                        }

                        <MudTextField @bind-Value="_currentPassword"
                                      Label="Current password"
                                      Variant="Variant.Outlined"
                                      InputType="InputType.Password"
                                      Disabled="@_savingPassword" />

                        <MudTextField @bind-Value="_newPassword"
                                      Label="New password"
                                      Variant="Variant.Outlined"
                                      InputType="InputType.Password"
                                      HelperText="Minimum 6 characters."
                                      Disabled="@_savingPassword" />

                        <MudTextField @bind-Value="_confirmNewPassword"
                                      Label="Confirm new password"
                                      Variant="Variant.Outlined"
                                      InputType="InputType.Password"
                                      Disabled="@_savingPassword" />

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   OnClick="ChangePasswordAsync"
                                   Disabled="@_savingPassword">
                            @if (_savingPassword)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            }
                            Change password
                        </MudButton>
                    </MudStack>
                </ChildContent>
            </PageSection>
        </MudItem>
    </MudGrid>
</MudStack>
