@page "/users"
@attribute [Authorize(Policy = AppPolicyFor.AdminOnly)]

<PageTitle>Users</PageTitle>

<MudStack Spacing="3">
    <PageHeader Title="Users"
                Section="Administration"
                Subtitle="Inspect people, roles, and ownership context in an admin-only workspace."
                Breadcrumbs="@_breadcrumbs" />

    <DataGridShell TItem="UserSummary"
                   Section="Directory"
                   Title="People directory"
                   Subtitle="This module demonstrates role-aware administration views on top of shared list primitives."
                   Items="@_users"
                   ErrorMessage="@_errorMessage"
                   IsLoading="@_isLoading"
                   EmptyTitle="No users matched"
                   EmptyMessage="Try a broader search term to expand the directory results.">
        <ToolbarContent>
            <PageToolbar>
                <MudTextField T="string" Label="Search users" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_searchInput" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ApplySearch">Search</MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="ClearSearch">Clear</MudButton>
            </PageToolbar>
        </ToolbarContent>
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Email</MudTh>
            <MudTh>Role</MudTh>
            <MudTh>Status</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.DisplayName</MudTd>
            <MudTd DataLabel="Email">@context.Email</MudTd>
            <MudTd DataLabel="Role">
                <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small" Color="Color.Secondary">@context.Role</MudChip>
            </MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Variant="Variant.Filled" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                    @(context.IsActive ? "Active" : "Inactive")
                </MudChip>
            </MudTd>
            <MudTd>
                <MudStack Row="true" Spacing="0">
                    <MudIconButton Icon="@Icons.Material.Rounded.ManageAccounts"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   Title="Assign role"
                                   OnClick="@(() => OpenAssignRoleDialogAsync(context))" />
                    <MudIconButton Icon="@Icons.Material.Rounded.EditNote"
                                   Size="Size.Small"
                                   Color="Color.Default"
                                   Title="Edit user"
                                   OnClick="@(() => OpenEditDialogAsync(context))" />
                    <MudIconButton Icon="@Icons.Material.Rounded.DeleteOutline"
                                   Size="Size.Small"
                                   Color="Color.Error"
                                   Title="Delete user"
                                   Disabled="@_deletingUserId.Contains(context.Id)"
                                   OnClick="@(() => DeleteUserAsync(context))" />
                </MudStack>
            </MudTd>
        </RowTemplate>
        <FooterContent>
            @if (_totalPages > 1)
            {
                <div class="d-flex justify-center align-center pa-3">
                    <MudPagination Count="@_totalPages"
                                   Selected="@_currentPage"
                                   SelectedChanged="OnPageChanged"
                                   Color="Color.Primary"
                                   Variant="Variant.Outlined"
                                   ShowFirstButton="true"
                                   ShowLastButton="true" />
                    <MudText Typo="Typo.caption" Class="app-text-muted ml-3">
                        @_totalCount total
                    </MudText>
                </div>
            }
        </FooterContent>
    </DataGridShell>
</MudStack>
