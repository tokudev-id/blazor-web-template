@page "/login"
@attribute [AllowAnonymous]
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Login</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="login-screen">
    <MudGrid Spacing="4" Class="editorial-grid-center">
        <MudItem xs="12" lg="6">
            <MudPaper Elevation="0" Class="login-hero">
                <MudText Typo="Typo.overline" Class="editorial-kicker">Boilerplate</MudText>
                <MudText Typo="Typo.h1">A calmer frontend workspace for content teams.</MudText>
                <MudText Typo="Typo.body1" Class="editorial-muted">
                    MudBlazor gives the dashboard a dependable component system, while the underlying project split keeps API code, shared contracts, and UI concerns easy to follow.
                </MudText>
                <MudStack Spacing="2" Class="login-benefits">
                    <MudPaper Elevation="0" Class="login-benefit">
                        <MudText Typo="Typo.subtitle1">Role-aware navigation</MudText>
                        <MudText Typo="Typo.body2" Class="editorial-muted">Admin, Editor, and Viewer experiences stay inside the same clean shell.</MudText>
                    </MudPaper>
                    <MudPaper Elevation="0" Class="login-benefit">
                        <MudText Typo="Typo.subtitle1">REST-only data access</MudText>
                        <MudText Typo="Typo.body2" Class="editorial-muted">Pages stay free of raw HTTP concerns while backend adapters handle auth and mapping.</MudText>
                    </MudPaper>
                </MudStack>
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                    Demo account: <strong>emilys</strong> / <strong>emilyspass</strong>
                </MudAlert>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" lg="6">
            <MudPaper Elevation="0" Class="login-panel">
                <MudText Typo="Typo.overline" Class="editorial-kicker">Authentication</MudText>
                <MudText Typo="Typo.h3">Sign in</MudText>
                <MudText Typo="Typo.body2" Class="editorial-muted">Start a secure cookie-backed session and open the editorial workspace.</MudText>

                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true">@_errorMessage</MudAlert>
                }

                <EditForm Model="LoginCommand" FormName="login-form" method="post" OnValidSubmit="HandleLoginAsync">
                    <DataAnnotationsValidator />
                    <MudStack Spacing="2" Class="login-form">
                        <MudTextField T="string"
                                      Label="Username"
                                      Variant="Variant.Outlined"
                                      @bind-Value="LoginCommand.Username"
                                      For="@(() => LoginCommand.Username)"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Rounded.Person" />
                        <MudTextField T="string"
                                      Label="Password"
                                      Variant="Variant.Outlined"
                                      InputType="InputType.Password"
                                      @bind-Value="LoginCommand.Password"
                                      For="@(() => LoginCommand.Password)"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Rounded.Lock" />
                        <MudButton Color="Color.Primary"
                                   Variant="Variant.Filled"
                                   Size="Size.Large"
                                   FullWidth="true"
                                   ButtonType="ButtonType.Submit"
                                   Disabled="@_isSubmitting">
                            @(_isSubmitting ? "Signing in..." : "Open dashboard")
                        </MudButton>
                    </MudStack>
                </EditForm>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromForm]
    private LoginCommand LoginCommand { get; set; } = new();

    private string? _errorMessage;
    private bool _isSubmitting;

    protected override void OnInitialized()
    {
        if (HttpContext?.User.Identity?.IsAuthenticated == true)
        {
            NavigationManager.NavigateTo("/dashboard", forceLoad: true);
        }
    }

    private async Task HandleLoginAsync()
    {
        if (_isSubmitting)
        {
            return;
        }

        _isSubmitting = true;
        _errorMessage = null;

        var result = await AuthService.LoginAsync(LoginCommand);
        _isSubmitting = false;

        if (result.IsFailure)
        {
            _errorMessage = result.Error?.Message ?? "The sign-in attempt could not be completed.";
            return;
        }

        NavigationManager.NavigateTo(ResolveReturnUrl(ReturnUrl), forceLoad: true);
    }

    private static string ResolveReturnUrl(string? returnUrl)
    {
        if (string.IsNullOrWhiteSpace(returnUrl))
        {
            return "/dashboard";
        }

        return returnUrl.StartsWith('/') && !returnUrl.StartsWith("//", StringComparison.Ordinal)
            ? returnUrl
            : "/dashboard";
    }
}
