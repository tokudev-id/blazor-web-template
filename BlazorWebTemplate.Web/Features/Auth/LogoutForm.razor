@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<EditForm class="logout-form" Model="_formModel" FormName="logout-form" method="post" OnSubmit="HandleLogoutAsync">
    <MudButton Variant="Variant.Text"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Rounded.Logout"
               ButtonType="ButtonType.Submit"
               Disabled="@_isSubmitting">
        @(_isSubmitting ? "Signing out..." : "Sign out")
    </MudButton>
</EditForm>

@code {
    private readonly object _formModel = new();
    private bool _isSubmitting;

    private async Task HandleLogoutAsync(EditContext _)
    {
        if (_isSubmitting)
        {
            return;
        }

        _isSubmitting = true;
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("/login", forceLoad: true);
    }
}
