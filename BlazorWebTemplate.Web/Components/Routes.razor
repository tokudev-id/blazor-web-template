@using BlazorWebTemplate.Web.Layout

<CascadingAuthenticationState>
    <Router AppAssembly="typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="typeof(MainLayout)">
                <section class="content-shell page-intro">
                    <p class="eyebrow">Route</p>
                    <h1>Page not found</h1>
                    <p class="lede">The link you followed does not exist in this starter module set.</p>
                    <a class="btn btn-primary" href="/dashboard">Return to dashboard</a>
                </section>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
