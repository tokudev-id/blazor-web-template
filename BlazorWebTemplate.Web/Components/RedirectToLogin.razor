@inject NavigationManager NavigationManager

@if (_showAccessDenied)
{
    <section class="content-shell page-intro">
        <p class="eyebrow">Authorization</p>
        <h1>Access denied</h1>
        <p class="lede">Your account is authenticated, but the current role does not allow access to this module.</p>
        <a class="btn btn-primary" href="/dashboard">Back to dashboard</a>
    </section>
}
else
{
    <section class="content-shell page-intro">
        <p class="eyebrow">Authentication</p>
        <h1>Redirecting</h1>
        <p class="lede">You need to sign in before opening this screen.</p>
    </section>
}

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private bool _showAccessDenied;

    protected override void OnInitialized()
    {
        var isAuthenticated = HttpContext?.User.Identity?.IsAuthenticated == true;

        if (isAuthenticated)
        {
            _showAccessDenied = true;
            return;
        }

        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var localReturnUrl = string.IsNullOrWhiteSpace(relativePath) ? "/dashboard" : $"/{relativePath}";
        NavigationManager.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(localReturnUrl)}", forceLoad: true);
    }
}
