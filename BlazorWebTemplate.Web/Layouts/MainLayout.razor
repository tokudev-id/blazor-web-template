@inherits LayoutComponentBase

<MudLayout Class="app-shell">
    <MudAppBar Elevation="0" Dense="true" Class="app-shell__appbar px-4 py-2" Style="height: 64px;">
        <MudHidden Breakpoint="Breakpoint.MdAndUp">
            <MudIconButton Icon="@Icons.Material.Rounded.Menu"
                           Color="Color.Inherit"
                           OnClick="@ShellState.ToggleDrawer"
                           Class="app-shell__menu-button"
                           aria-label="Toggle navigation" />
        </MudHidden>

        <MudSpacer />

        <MudIconButton Icon="@Icons.Material.Rounded.Notifications" Size="Size.Small" Color="Color.Default" Class="mx-1" />
        <MudIconButton Icon="@Icons.Material.Rounded.Help" Size="Size.Small" Color="Color.Default" Class="mx-1" />
        <MudButton Variant="Variant.Text" Color="Color.Primary" Style="font-weight: 600; text-transform: none; margin-left: 8px;">Control Center</MudButton>
    </MudAppBar>

    <MudDrawer Open="@ShellState.IsDrawerOpen"
               OpenChanged="@ShellState.SetDrawer"
               Elevation="0"
               Width="260px"
               Breakpoint="Breakpoint.Md"
               Variant="DrawerVariant.Responsive"
               ClipMode="DrawerClipMode.Never"
               Class="app-shell__drawer">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="app-shell__main">
        <MudContainer MaxWidth="MaxWidth.False" Class="app-shell__content">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>
